
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // -------------------------------------------------------------------------
    // Helper Functions
    // -------------------------------------------------------------------------

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Validates that critical, immutable fields are not changed during an update.
    function areImmutableFieldsUnchanged() {
      return request.resource.data.id == resource.data.id
          && request.resource.data.email == resource.data.email
          && request.resource.data.createdAt == resource.data.createdAt;
    }

    // Performs comprehensive validation on user profile data for create and update.
    function isValidUserData(data) {
      let profile = data.get('profile', {});
      let health = data.get('health', {});
      let goals = data.get('goals', {});
      
      let isNameValid = data.name is string && data.name.size() > 1;

      // Profile validation (optional fields for updates)
      let isGenderValid = !('gender' in profile) || profile.gender in ['male', 'female', 'other'];
      let isAgeValid = !('age' in profile) || (profile.age is number && profile.age >= 1 && profile.age <= 120);
      let isHeightValid = !('heightCm' in profile) || (profile.heightCm is number && profile.heightCm > 0);
      let isWeightValid = !('weightKg' in profile) || (profile.weightKg is number && profile.weightKg > 0);
      let isActivityValid = !('activityLevel' in profile) || profile.activityLevel in ['low', 'moderate', 'active', 'very-active'];
      
      // Health validation (optional fields for updates)
      let isPrimaryGoalValid = !('primaryGoal' in health) || health.primaryGoal in ['lose-weight', 'maintain-weight', 'gain-weight', 'eat-healthier'];
      
      // Goals validation (optional fields for updates)
      let isCalorieGoalValid = !('dailyCalorieGoal' in goals) || (goals.dailyCalorieGoal is number && goals.dailyCalorieGoal > 0);
      let isProteinGoalValid = !('proteinPercentageGoal' in goals) || (goals.proteinPercentageGoal is number && goals.proteinPercentageGoal >= 0 && goals.proteinPercentageGoal <= 100);
      let isCarbsGoalValid = !('carbsPercentageGoal' in goals) || (goals.carbsPercentageGoal is number && goals.carbsPercentageGoal >= 0 && goals.carbsPercentageGoal <= 100);
      let isFatGoalValid = !('fatPercentageGoal' in goals) || (goals.fatPercentageGoal is number && goals.fatPercentageGoal >= 0 && goals.fatPercentageGoal <= 100);
      
      return isNameValid
          && isGenderValid && isAgeValid && isHeightValid && isWeightValid && isActivityValid
          && isPrimaryGoalValid
          && isCalorieGoalValid && isProteinGoalValid && isCarbsGoalValid && isFatGoalValid;
    }

    // -------------------------------------------------------------------------
    // Collection Rules
    // -------------------------------------------------------------------------

    match /users/{userId} {
      allow get, delete: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId) && isValidUserData(request.resource.data);
      allow update: if isOwner(userId) && areImmutableFieldsUnchanged() && isValidUserData(request.resource.data);

      /**
       * @description Manages a user's private daily nutrition logs.
       * A recursive wildcard `{docId=**}` is used to grant the owner
       * full read/write access to this subcollection and any documents within it.
       */
      match /dailyLogs/{docId=**} {
        allow read, write: if isOwner(userId);
      }
      
      /**
       * @description Manages a user's generated recommendation history.
       * A recursive wildcard is used for simplicity and robustness.
       */
      match /generatedRecommendations/{docId=**} {
        allow read, write: if isOwner(userId);
      }

      /**
       * @description Manages AI food recognition scans.
       * A recursive wildcard is used for simplicity and robustness.
       */
      match /aiScans/{docId=**} {
         allow read, write: if isOwner(userId);
      }
      
      /**
       * @description Manages a user's private meal plans.
       * A recursive wildcard is used for simplicity and robustness.
       */
      match /plannedMeals/{docId=**} {
        allow read, write: if isOwner(userId);
      }
      
      /**
       * @description Manages a user's recent search history.
       */
      match /recentSearches/{docId=**} {
        allow read, write: if isOwner(userId);
      }
    }

    /**
     * @description A global, public database of food items. This data is readable
     *              by all authenticated users. Writes are also allowed to enable
     *              the AI service to cache new recipes, but deletes are blocked.
     * @path /foodItems/{foodItemId}
     */
    match /foodItems/{foodItemId} {
      allow get, list, create, update: if isSignedIn();
      allow delete: if false;
    }
  }
}
