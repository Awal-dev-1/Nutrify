/**
 * # Firestore Security Rules for Nutrify
 *
 * ## Core Philosophy
 * This ruleset enforces a strict user-ownership model. All user-generated data,
 * including profiles, food logs, and meal plans, is private and can only be
 * accessed by the user who created it. This ensures strong data privacy and
 * prevents users from accessing or modifying each other's sensitive information.
 * Public data, like the global food database, is read-only for all authenticated
 * users.
 *
 * ## Data Structure
 * The data is organized hierarchically to reflect ownership:
 * - `/users/{userId}`: A top-level collection where each document represents a single
 *   user's profile. The document ID `{userId}` is the user's Firebase Auth UID.
 * - `/users/{userId}/dailyFoodLogs/{logId}`: A subcollection containing the user's
 *   private daily food consumption records.
 * - `/users/{userId}/mealPlans/{planId}`: A subcollection for the user's private
 *   meal plans.
 * - `/foodItems/{foodId}`: A separate top-level collection containing a global,
 *   read-only library of food nutritional information.
 *
 * ## Key Security Decisions
 * - **No User Enumeration**: Listing the entire `/users` collection is explicitly
 *   disallowed to protect user privacy.
 * - **Strict Ownership**: All access to a user's data tree (`/users/{userId}/...`)
 *   is gated by checking if the requester's UID matches the `{userId}` in the path.
 * - **Read-Only Global Data**: The `/foodItems` collection is read-only for
 *   authenticated users. All client-side write operations are blocked to maintain
 *   the integrity of the global food database.
 * - **Relational Integrity**: When creating documents in user-specific subcollections
 *   (e.g., a new food log), the rules enforce that the document's internal `userId`
 *   field must match the parent path, ensuring data consistency.
 *
 * ## Denormalization for Authorization
 * To create fast and secure rules, ownership information is denormalized. Each
 * document in a user-specific subcollection (like `dailyFoodLogs`) contains a
 * `userId` field. This allows rules to validate ownership directly from the
 * document being created or updated without needing slow and costly `get()` calls
 * to parent documents.
 *
 * ## Structural Segregation
 * Private user data (`/users`) and public data (`/foodItems`) are stored in
 * separate top-level collections. This clear separation simplifies rule logic,
 * improves query performance, and provides a strong security boundary.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // -------------------------------------------------------------------------
    // Helper Functions
    // -------------------------------------------------------------------------

    /**
     * Checks if the user is authenticated.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * Checks if the authenticated user is the owner of the document based on the path.
     */
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    /**
     * Checks if the document exists and the user is the owner.
     * Used for state-changing operations like update and delete.
     */
    function isExistingOwner(userId) {
      return isOwner(userId) && resource != null;
    }

    /**
     * Validates that the core identifying fields of a new user profile
     * match the user's authentication context.
     * In Prototyping Mode, we only validate authorization-critical fields.
     */
    function isValidUserProfileCreate(userId) {
      let data = request.resource.data;
      return data.id == userId && data.email == request.auth.token.email;
    }

    /**
     * Ensures critical, immutable fields of a user profile are not changed on update.
     */
    function isUserProfileImmutable() {
      let data = request.resource.data;
      return data.id == resource.data.id && data.email == resource.data.email;
    }

    /**
     * Validates that a new document in a user subcollection (e.g., food log)
     * has its internal `userId` field set correctly to the owner's UID.
     */
    function isValidSubcollectionCreate(userId) {
      return request.resource.data.userId == userId;
    }

    /**
     * Ensures the ownership link (`userId`) on a subcollection document is immutable.
     */
    function isOwnerFieldImmutable() {
      return request.resource.data.userId == resource.data.userId;
    }

    // -------------------------------------------------------------------------
    // Collection Rules
    // -------------------------------------------------------------------------

    /**
     * @description Manages user profiles. Users can create, read, and update their
     *              own profile, but cannot read other users' profiles or list the
     *              collection to prevent user enumeration.
     * @path /users/{userId}
     * @allow (create) An authenticated user creating their own profile document
     *        where the document ID matches their UID.
     * @deny (get) A signed-in user trying to read another user's profile document.
     * @principle Restricts access to a user's own data tree and prevents data leakage.
     */
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId) && isValidUserProfileCreate(userId);
      allow update: if isExistingOwner(userId) && isUserProfileImmutable();
      allow delete: if isExistingOwner(userId);

      /**
       * @description Manages a user's private daily food logs. Users have full
       *              control over their own logs.
       * @path /users/{userId}/dailyFoodLogs/{dailyFoodLogId}
       * @allow (create) An authenticated user adding a new food log to their own
       *        subcollection.
       * @deny (list) A user trying to list the food logs of another user.
       * @principle Enforces document ownership for writes and ensures relational integrity.
       */
      match /dailyFoodLogs/{dailyFoodLogId} {
        allow get: if isOwner(userId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidSubcollectionCreate(userId);
        allow update: if isExistingOwner(userId) && isOwnerFieldImmutable();
        allow delete: if isExistingOwner(userId);
      }

      /**
       * @description Manages a user's private meal plans. Users have full control
       *              over their own meal plans.
       * @path /users/{userId}/mealPlans/{mealPlanId}
       * @allow (update) An authenticated user updating an existing meal plan in
       *        their own subcollection.
       * @deny (create) A user trying to create a meal plan for another user.
       * @principle Enforces document ownership for writes and ensures relational integrity.
       */
      match /mealPlans/{mealPlanId} {
        allow get: if isOwner(userId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidSubcollectionCreate(userId);
        allow update: if isExistingOwner(userId) && isOwnerFieldImmutable();
        allow delete: if isExistingOwner(userId);
      }
    }

    /**
     * @description A global, public database of food items. This data is intended
     *              to be readable by all authenticated application users but not
     *              writable by them, protecting it from client-side changes.
     * @path /foodItems/{foodItemId}
     * @allow (get, list) Any authenticated user can read or list food items to
     *        populate their meal logs.
     * @deny (create, update, delete) All write operations are forbidden from the
     *       client to protect data integrity.
     * @principle Provides public read access while preventing unauthorized writes.
     */
    match /foodItems/{foodItemId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }
  }
}