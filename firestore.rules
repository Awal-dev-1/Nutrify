/**
 * # Firestore Security Rules for Nutrify
 *
 * ## Core Philosophy
 * This ruleset enforces a strict user-ownership model. All user-generated data,
 * including profiles, and daily logs, is private and can only be
 * accessed by the user who created it. This ensures strong data privacy and
 * prevents users from accessing or modifying each other's sensitive information.
 * Public data, like the global food database, is read-only for all authenticated
 * users.
 *
 * ## Data Structure
 * The data is organized hierarchically to reflect ownership:
 * - `/users/{userId}`: A top-level collection where each document represents a single
 *   user's profile. The document ID `{userId}` is the user's Firebase Auth UID.
 * - `/users/{userId}/dailyLogs/{date}`: A subcollection containing aggregated
 *   daily nutrition data. The document ID `{date}` is the date string 'YYYY-MM-DD'.
 * - `/foodItems/{foodId}`: A separate top-level collection containing a global,
 *   read-only library of food nutritional information.
 *
 * ## Key Security Decisions
 * - **No User Enumeration**: Listing the entire `/users` collection is explicitly
 *   disallowed to protect user privacy.
 * - **Strict Ownership**: All access to a user's data tree (`/users/{userId}/...`)
 *   is gated by checking if the requester's UID matches the `{userId}` in the path.
 * - **Publicly Writable Food Data**: The `/foodItems` collection is readable by all
 *   authenticated users. Client-side writes are permitted to allow the AI to
 *   cache new food details, but deletes are blocked to prevent data loss.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // -------------------------------------------------------------------------
    // Helper Functions
    // -------------------------------------------------------------------------

    /**
     * Checks if the user is authenticated.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * Checks if the authenticated user is the owner of the document based on the path.
     */
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    /**
     * Checks if the document exists and the user is the owner.
     * Used for state-changing operations like update and delete.
     */
    function isExistingOwner(userId) {
      return isOwner(userId) && resource != null;
    }

    /**
     * Validates that the core identifying fields of a new user profile
     * match the user's authentication context.
     * In Prototyping Mode, we only validate authorization-critical fields.
     */
    function isValidUserProfileCreate(userId) {
      let data = request.resource.data;
      return data.id == userId && data.email == request.auth.token.email;
    }

    /**
     * Ensures critical, immutable fields of a user profile are not changed on update.
     */
    function isUserProfileImmutable() {
      let data = request.resource.data;
      return data.id == resource.data.id && data.email == resource.data.email;
    }

    // -------------------------------------------------------------------------
    // Collection Rules
    // -------------------------------------------------------------------------

    /**
     * @description Manages user profiles. Users can create, read, and update their
     *              own profile, but cannot read other users' profiles or list the
     *              collection to prevent user enumeration.
     * @path /users/{userId}
     */
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId) && isValidUserProfileCreate(userId);
      allow update: if isExistingOwner(userId) && isUserProfileImmutable();
      allow delete: if isExistingOwner(userId);

      /**
       * @description Manages a user's private daily nutrition logs. Users have full
       *              read and write control over their own logs to allow for
       *              client-side aggregation and updates.
       * @path /users/{userId}/dailyLogs/{date}
       */
      match /dailyLogs/{date} {
        allow read, write: if isOwner(userId);
      }
      
      /**
       * @description Manages a user's generated recommendation history.
       * @path /users/{userId}/generatedRecommendations/{recommendationId}
       */
      match /generatedRecommendations/{recommendationId} {
        allow read, write: if isOwner(userId);
      }

      /**
       * @description Manages AI food recognition scans. Users can create and read their own
       *              scan documents.
       * @path /users/{userId}/aiScans/{scanId}
       */
      match /aiScans/{scanId} {
        allow read, write: if isOwner(userId);
      }
    }

    /**
     * @description A global, public database of food items. This data is readable
     *              by all authenticated users. Writes are also allowed to enable
     *              the AI service to cache new recipes, but deletes are blocked.
     * @path /foodItems/{foodItemId}
     */
    match /foodItems/{foodItemId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      // Allow create/update so the client can cache AI-generated food details
      // for the "View Recipe" feature. Deletes are disallowed to prevent data loss.
      allow create, update: if isSignedIn();
      allow delete: if false;
    }
  }
}
