rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // TEMPORARY DIAGNOSTIC RULE: Allow all reads and writes to all documents
    // to isolate the source of the persistent permission error.
    // THIS IS INSECURE and will be removed once the issue is diagnosed.
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
