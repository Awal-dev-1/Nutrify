rules_version = '2';

// Access to Firebase Storage
// https://firebase.google.com/docs/storage/security
service firebase.storage {
  match /b/{bucket}/o {
    // Files for a given user, such as profile pictures.
    // The user can read and write their own files.
    match /users/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // AI recognition scan images
    // The user can read and write their own scan images.
    match /ai-recognition/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
